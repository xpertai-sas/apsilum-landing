---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Solicitar una demo · APSILUM"
  description="Pedí una demostración de APSILUM con el inventario de tu municipio."
  path="/demo/"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Solicitar una demo</p>
      <h1>Traé tu inventario. Nosotros lo hacemos defendible.</h1>
      <p class="lead">
        La demostración usa los datos de tu municipio, no un ejemplo. Contanos qué tenés y
        coordinamos una sesión de 30 minutos.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <form
        class="form"
        method="post"
        action="mailto:hola@apsilum.com?subject=Solicitud%20de%20demo%20APSILUM"
        enctype="text/plain"
      >
        <label>
          Nombre y apellido
          <input type="text" name="nombre" required autocomplete="name" />
        </label>
        <label>
          Entidad o empresa
          <input type="text" name="entidad" required autocomplete="organization" />
        </label>
        <label>
          Correo
          <input type="email" name="correo" required autocomplete="email" />
        </label>
        <label>
          Qué necesitás contar (opcional)
          <textarea name="mensaje" rows="4"></textarea>
        </label>
        <button class="btn btn-solid" type="submit">Enviar solicitud</button>
        <p class="nota">
          El formulario abre tu cliente de correo. Si preferís, escribí directo a
          <a href="mailto:hola@apsilum.com">hola@apsilum.com</a>.
        </p>
      </form>
    </div>
  </section>
</Base>
